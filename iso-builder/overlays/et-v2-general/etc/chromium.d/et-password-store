# LiaisonOS — make Chromium cookie/password encryption portable across reboots.
#
# By default Chromium encrypts cookies and saved passwords with a key from the
# desktop keyring (gnome-libsecret / kwallet). On a live/persistence system the
# keyring key is not stable across sessions, so restored cookies would fail to
# decrypt and sites like Teams would log out on every boot — defeating the
# persistence. Forcing the "basic" store keeps the key in the profile's
# "Local State" file (which et-persistence saves/restores), so logins survive.
#
# This file is sourced by Debian's /usr/bin/chromium launcher.
export CHROMIUM_FLAGS="${CHROMIUM_FLAGS} --password-store=basic"
