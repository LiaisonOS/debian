{
  "version": "2.0.0",
  "description": "LiaisonOS config persistence mapping",
  "apps": {
    "liaisonos-core": {
      "name": "LiaisonOS Core",
      "persistence_subdir": "",
      "configs": [
        {
          "source": "user.json",
          "target": "${HOME}/.config/liaisonos/user.json",
          "type": "file",
          "required": true
        }
      ]
    },
    "automation": {
      "name": "LiaisonOS Automation",
      "persistence_subdir": "configs/liaisonos",
      "configs": [
        {
          "source": "automation.json",
          "target": "${HOME}/.config/liaisonos/automation.json",
          "type": "file",
          "required": false,
          "description": "Scheduled automation — missions and presence windows"
        }
      ],
      "data": [
        {
          "source": "bulletins/pending",
          "target": "${HOME}/.config/liaisonos/bulletins/pending",
          "type": "directory",
          "required": false,
          "description": "Bulletin bodies (.txt + .json) referenced by bbs_publish missions"
        }
      ]
    },
    "et-logger": {
      "name": "Field Logger (et-logger)",
      "persistence_subdir": "configs/liaisonos",
      "configs": [
        {
          "source": "qrz.json",
          "target": "${HOME}/.config/liaisonos/logger/qrz.json",
          "type": "file",
          "required": false,
          "description": "QRZ.com XML-API credentials for online callsign lookup"
        }
      ]
    },
    "pat": {
      "name": "Pat Winlink",
      "persistence_subdir": "configs/pat",
      "configs": [
        {
          "source": "config.json",
          "target": "${HOME}/.config/pat/config.json",
          "type": "file",
          "required": true
        }
      ],
      "data": [
        {
          "source": "../mailbox",
          "target": "${HOME}/.local/share/pat/mailbox",
          "type": "directory",
          "description": "Winlink mailbox (in/out/sent/archive)"
        }
      ]
    },
    "js8call": {
      "name": "JS8Call",
      "persistence_subdir": "configs/js8call",
      "configs": [
        {
          "source": "JS8Call.ini",
          "target": "${HOME}/.config/JS8Call.ini",
          "type": "file",
          "required": true
        }
      ]
    },
    "wsjtx": {
      "name": "WSJT-X",
      "persistence_subdir": "configs/wsjtx",
      "configs": [
        {
          "source": "WSJT-X.ini",
          "target": "${HOME}/.config/WSJT-X.ini",
          "type": "file",
          "required": true
        }
      ]
    },
    "fldigi": {
      "name": "Fldigi",
      "persistence_subdir": "configs/fldigi",
      "configs": [
        {
          "source": "fldigi_def.xml",
          "target": "${HOME}/.fldigi/fldigi_def.xml",
          "type": "file",
          "required": true
        },
        {
          "source": "macros/",
          "target": "${HOME}/.fldigi/macros/",
          "type": "directory",
          "required": false
        }
      ]
    },
    "flmsg": {
      "name": "Flmsg",
      "persistence_subdir": "configs/flmsg",
      "configs": [
        {
          "source": "flmsg_def.xml",
          "target": "${HOME}/.flmsg/flmsg_def.xml",
          "type": "file",
          "required": true
        }
      ]
    },
    "vara_hf": {
      "name": "VARA HF",
      "persistence_subdir": "configs/vara",
      "configs": [
        {
          "source": "VARA.ini",
          "target": "${HOME}/.wine32/drive_c/VARA/VARA.ini",
          "type": "file",
          "required": true
        }
      ]
    },
    "vara_fm": {
      "name": "VARA FM",
      "persistence_subdir": "configs/vara",
      "configs": [
        {
          "source": "VARAFM.ini",
          "target": "${HOME}/.wine32/drive_c/VARAFM/VARAFM.ini",
          "type": "file",
          "required": true
        }
      ]
    },
    "varac": {
      "name": "VarAC",
      "persistence_subdir": "configs/varac",
      "configs": [
        {
          "source": "VarAC.ini",
          "target": "${HOME}/.wine32/drive_c/VarAC/VarAC.ini",
          "type": "file",
          "required": true
        },
        {
          "source": "license.flag",
          "target": "${HOME}/.config/liaisonos/varac/license.flag",
          "type": "file",
          "required": false,
          "description": "VarAC Limited Distribution Agreement acceptance"
        },
        {
          "source": "license-audit.log",
          "target": "${HOME}/.config/liaisonos/varac/license-audit.log",
          "type": "file",
          "required": false,
          "description": "VarAC license audit trail"
        }
      ]
    },
    "direwolf": {
      "name": "Direwolf",
      "persistence_subdir": "configs/direwolf",
      "configs": [
        {
          "source": "direwolf.conf",
          "target": "${HOME}/.config/direwolf/direwolf.conf",
          "type": "file",
          "required": true
        }
      ]
    },
    "mesh25": {
      "name": "Mesh25",
      "persistence_subdir": "configs/mesh25",
      "configs": [
        {
          "source": "keystore.txt",
          "target": "${HOME}/.config/liaisonos/mesh25/keystore.txt",
          "type": "file",
          "required": false,
          "description": "Mesh25 keystore — Ed25519 identity + learned peer public keys + trust (critical: losing it re-generates identity every reboot)"
        },
        {
          "source": "history.json",
          "target": "${HOME}/.local/share/liaisonos/qtchattervox/history.json",
          "type": "file",
          "required": false,
          "description": "Mesh25 chat history"
        },
        {
          "source": "mail.json",
          "target": "${HOME}/.local/share/liaisonos/qtchattervox/mail.json",
          "type": "file",
          "required": false,
          "description": "Mesh25 mailbox (inbox/sent)"
        },
        {
          "source": "parked",
          "target": "${HOME}/.local/share/liaisonos/mesh25",
          "type": "dir",
          "required": false,
          "description": "Mesh25 parked mail held for other stations"
        }
      ]
    },
    "potacat": {
      "name": "POTACAT",
      "persistence_subdir": "configs/potacat",
      "configs": [
        {
          "source": "potacat",
          "target": "${HOME}/.config/POTACAT",
          "type": "dir",
          "required": false,
          "description": "POTACAT (POTA spot aggregator / logger) Electron user data — QSO log + settings"
        }
      ]
    },
    "linbpq": {
      "name": "LinBPQ BBS",
      "persistence_subdir": "configs/linbpq",
      "configs": [
        {
          "source": "bpq32.cfg",
          "target": "${HOME}/.local/share/emcomm-tools/bbs-server/bpq32.cfg",
          "type": "file",
          "required": false
        }
      ]
    },
    "x11vnc": {
      "name": "x11vnc (VNC server)",
      "persistence_subdir": "configs/x11vnc",
      "configs": [
        {
          "source": "passwd",
          "target": "${HOME}/.vnc/passwd",
          "type": "file",
          "required": false,
          "description": "x11vnc VNC server password (set with 'x11vnc -storepasswd'); persisted across USB reboots and saved configs"
        }
      ]
    }
  }
}
