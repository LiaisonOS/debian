#!/bin/bash
#
# et-kiss-detect — capture the currently-connected USB serial KISS TNC and
#                  map it to a stable /dev/et-kiss symlink.
#
# Why: a USB KISS TNC (e.g. Kenwood TH-D72) is a bare CP210x (10c4:ea60) with
# no model info, so it can't be auto-distinguished from a DigiRig or any other
# CP210x. The DigiRig-Mobile udev rule otherwise grabs ANY untagged 10c4:ea60
# tty as a CAT radio (/dev/et-cat + rigctld). This helper reads the connected
# adapter's unique chip serial and writes a per-station udev rule that claims
# THAT specific adapter as a KISS TNC (/dev/et-kiss, no rigctld), numbered
# before the DigiRig rule so it wins.
#
# Run (as root, via sudo) from QtDashboard when a USB-KISS radio is selected.
# Rewrites the single rule each time, so /dev/et-kiss always points at the
# adapter you just selected.
#
# Author : Sylvain Deguire (VA2OPS)

set -u

RULE="/etc/udev/rules.d/86-et-kiss-local.rules"

log(){ echo "et-kiss-detect: $*"; }
err(){ echo "et-kiss-detect: ERROR: $*" >&2; }

# --- find connected CP210x (10c4:ea60) serial ports --------------------------
candidates=()
serials=()
for dev in /dev/ttyUSB*; do
    [ -e "$dev" ] || continue
    props=$(udevadm info -q property -n "$dev" 2>/dev/null)
    vid=$(echo "$props" | sed -n 's/^ID_VENDOR_ID=//p')
    pid=$(echo "$props" | sed -n 's/^ID_MODEL_ID=//p')
    ser=$(echo "$props" | sed -n 's/^ID_SERIAL_SHORT=//p')
    if [ "$vid" = "10c4" ] && [ "$pid" = "ea60" ] && [ -n "$ser" ]; then
        candidates+=("$dev")
        serials+=("$ser")
    fi
done

n=${#candidates[@]}
if [ "$n" -eq 0 ]; then
    err "no CP210x (10c4:ea60) USB serial adapter found — connect the TH-D72."
    exit 2
fi
if [ "$n" -gt 1 ]; then
    err "more than one CP210x adapter is connected (${candidates[*]}); connect only the TH-D72 and Apply again."
    exit 3
fi

DEV="${candidates[0]}"
SER="${serials[0]}"
log "found KISS TNC on $DEV (CP210x serial $SER)"

# --- write the per-station udev rule -----------------------------------------
cat > "$RULE" <<EOF
# Auto-generated by et-kiss-detect — USB serial KISS TNC (e.g. Kenwood TH-D72).
# Claims THIS adapter (by its CP210x serial) as a KISS TNC (/dev/et-kiss) and
# tags it so the DigiRig-Mobile rule (90-) skips it and rigctld is NOT started.
# Rewritten each time a USB-KISS radio is selected in the dashboard.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="$SER", ENV{ET_DEVICE}=="", \\
    ACTION=="add", \\
    ENV{ET_DEVICE}="TH-D72", ENV{ET_SUBDEVICE}="KISS", GROUP="dialout", MODE="0660", SYMLINK+="et-kiss"
EOF
log "wrote $RULE"

# --- the DigiRig rule may already have grabbed it (et-cat + rigctld); undo ---
systemctl stop rigctld 2>/dev/null || true

# --- reload + re-trigger ONLY this device so the new rule applies now (no
#     replug needed) and we don't disturb other connected radios' rigctld ------
udevadm control --reload-rules
SYSPATH=$(udevadm info -q path -n "$DEV" 2>/dev/null)
if [ -n "$SYSPATH" ]; then
    udevadm trigger --action=add "/sys$SYSPATH" >/dev/null 2>&1
else
    udevadm trigger --action=add --subsystem-match=tty >/dev/null 2>&1
fi
udevadm settle --timeout=5 >/dev/null 2>&1

if [ -e /dev/et-kiss ]; then
    log "OK — /dev/et-kiss -> $(readlink -f /dev/et-kiss)"
    exit 0
fi
err "/dev/et-kiss not created; a replug of the radio may be needed."
exit 1
