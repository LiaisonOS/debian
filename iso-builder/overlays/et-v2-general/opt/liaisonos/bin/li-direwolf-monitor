#!/bin/bash
#
# Author  : Sylvain Deguire (VA2OPS)
# Purpose : Give the sysop a live view into headless Direwolf. Opens a
#           terminal that tails ~/.local/share/emcomm-tools/direwolf.log
#           so decoded AX.25 frames, audio-level readouts
#           ("audio level = XX(YY/ZZ)"), PTT toggles, and Direwolf
#           warnings/errors are visible in real time.
#
#           Direwolf itself keeps running under et-supervisor — this is
#           just a viewport. Closing the terminal stops the tail; the
#           modem is unaffected.
#
# Usage   : li-direwolf-monitor           # default log path
#           li-direwolf-monitor <logfile> # explicit path
#

LOG="${1:-$HOME/.local/share/emcomm-tools/direwolf.log}"

# Ensure the file exists so `tail -F` doesn't complain on cold start.
mkdir -p "$(dirname "$LOG")"
touch "$LOG"

# Match the chattervox mode pattern (chat-chattervox-bt.json) which uses
# a plain `-e` with a simple command string — that combination is known
# to launch reliably under et-supervisor. --disable-server makes each
# invocation an independent process (no shared terminal-server).
exec xfce4-terminal \
    --disable-server \
    --title="Direwolf Monitor" \
    --geometry=120x32 \
    -e "tail -n 40 -F $LOG"
